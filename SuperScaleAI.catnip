      "nodeData": {
        "codeText": "\u0022\u0022\u0022One ready-made super-resolution model: where to get it and how much it enlarges.\u0022\u0022\u0022\n\nfrom dataclasses import dataclass\n\n\n@dataclass(frozen=True)\nclass ModelSpec:\n\tname: str\n\tscale: int\n\turl: str\n\tsha256: str\n\n\t@property\n\tdef file_name(self) -\u003E str:\n\t\treturn self.url.rsplit(\u0022/\u0022, 1)[-1]\n",
        "codeFile": "",
        "maxInputNumber": 0,
        "maxOutputNumber": 0,
        "documentationText": "",
        "documentationFile": "ModelSpec.md",
        "nodeCathegory": 3,
